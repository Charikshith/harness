{
  // ---------- Appearance ----------
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "VSCodium Dark (Ported)"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "VSCode Icons for Zed (Dark NestJS)"
  },
"markdown_preview" : {"limit_content_width": true, "max_width": 1400}
,
  "file_types": {
    "JSON": ["jsonl", "ndjson"]
  },
  "languages": {
  "JSON": {
    "format_on_save": "on",
    "tab_size": 2
  },
  "JSON Lines": {
      "format_on_save": "on"
    }
}
,

  "experimental.theme_overrides": {
    // Diff hunk row bands. Dial: subtle #172319/#1d1515 .. strong #294a2b/#2d1919
    // Border set equal to the band so hunks have no bright outline.
    "editor.diff_hunk_added_background": "#213823",
    "editor.diff_hunk.added_background": "#213823",
    "editor.diff_hunk.added.background": "#213823",
    "editor.diff_hunk_added_hollow_background": "#213823",
    "editor.diff_hunk.added_hollow_background": "#213823",
    "editor.diff_hunk.added.hollow_background": "#213823",
    "editor.diff_hunk_added_hollow_border": "#213823",
    "editor.diff_hunk.added_hollow_border": "#213823",
    "editor.diff_hunk.added.hollow_border": "#213823",
    "editor.diff_hunk_deleted_background": "#261717",
    "editor.diff_hunk.deleted_background": "#261717",
    "editor.diff_hunk.deleted.background": "#261717",
    "editor.diff_hunk_deleted_hollow_background": "#261717",
    "editor.diff_hunk.deleted_hollow_background": "#261717",
    "editor.diff_hunk.deleted.hollow_background": "#261717",
    "editor.diff_hunk_deleted_hollow_border": "#261717",
    "editor.diff_hunk.deleted_hollow_border": "#261717",
    "editor.diff_hunk.deleted.hollow_border": "#261717",
    // Word-level boxes (confirmed working):
    "version_control.word_added": "#3b6f3e",
    "version_control.word_deleted": "#693330",
    // Gutter / git panel:
    "version_control.added": "#4a8f63",
    "version_control.modified": "#3f7fa8",
    "version_control.deleted": "#9e5a51"
  },

  // ---------- Fonts ----------
  // Verify "Consolas" against VSCodium's editor.fontFamily.
  // If Zed doesn't autocomplete the name, it can't see the font.
  "buffer_font_family": "Consolas",
  "buffer_font_size": 14,
  "buffer_line_height": { "custom": 1.35 },
  "buffer_font_features": { "calt": false },
  "buffer_font_weight": 400,
  "ui_font_family": "Segoe UI",
  "ui_font_size": 16,

  // ---------- Editor ----------
  "base_keymap": "VSCode",
  "code_lens": "off",
  "colorize_brackets": true,
  "inlay_hints": { "enabled": true },
  "which_key": { "enabled": true },
  "autosave": "on_window_change",
  "diff_view_style": "split",
  "cli_default_open_behavior": "new_window",
  "bottom_dock_layout": "contained",

  // ---------- Git ----------
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "git_panel": {
    "dock": "right",
    "status_style": "icon",
    "button": true,
    "show_count_badge": true,
    "file_icons": true,
    "collapse_untracked_diff": false,
    "tree_view": true
  },

  // ---------- Panels ----------
  "project_panel": {
    "diagnostic_badges": true,
    "bold_folder_labels": true,
    "hide_gitignore": false,
    "default_width": 240.0,
    "dock": "left",
    "git_status_indicator": true,
    "hide_root": false
  },
  "outline_panel": {
    "dock": "left",
    "git_status": true
  },
  "collaboration_panel": { "dock": "left" },
  "debugger": { "dock": "left" },
  "terminal": {
    "dock": "left",
    "show_count_badge": true,
    "button": true
  },

  // ---------- Chrome ----------
  "tab_bar": { "show_pinned_tabs_in_separate_row": false },
  "tabs": { "file_icons": true, "git_status": true },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": true,
    "show_branch_status_icon": true
  },
  "status_bar": { "line_endings_button": false },

  // ---------- Misc ----------
  "agent": {
    "button": true,
    "favorite_models": [],
    "model_parameters": []
  },
  "disable_ai": true,
  "session": { "trust_all_worktrees": true },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
