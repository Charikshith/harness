#!/bin/sh
# Enforces harness/memory/commit-is-not-session-end.md: a commit that changes
# version-4/ (the shipped tool) must also update harness/progress.md and
# harness/memory/journal.md in the same commit, not afterward.

staged=$(git diff --cached --name-only --diff-filter=ACMR)

echo "$staged" | grep -q '^version-4/' || exit 0

missing=""
echo "$staged" | grep -q '^harness/progress\.md$' || missing="$missing harness/progress.md"
echo "$staged" | grep -q '^harness/memory/journal\.md$' || missing="$missing harness/memory/journal.md"

if [ -n "$missing" ]; then
  echo "pre-commit: this commit touches version-4/ but is missing:$missing" >&2
  echo "  See harness/memory/commit-is-not-session-end.md" >&2
  echo "  Bypass for non-feature changes: git commit --no-verify" >&2
  exit 1
fi
